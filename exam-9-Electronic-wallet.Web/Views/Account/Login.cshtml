@model exam_9_Electronic_wallet.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Вход";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow p-4">
            <h2 class="text-center mb-4">Вход в кошелёк</h2>
            <form asp-controller="Account" asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label class="form-label">Email или номер счёта</label>
                    <input asp-for="Login" class="form-control"
                           placeholder="Введите email или 6 цифр"/>
                    <span asp-validation-for="Login" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Пароль</label>
                    <input asp-for="Password" class="form-control"
                           type="password"/>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Войти
                </button>
            </form>

            <p class="text-center mt-3">
                Нет аккаунта?
                <a asp-controller="Account" asp-action="Register">Регистрация</a>
            </p>
        </div>
    </div>
</div>
@section Scripts {

}

